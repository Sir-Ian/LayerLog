{
  "name": "layerlog",
  "version": "0.1.0",
  "private": true,
  "description": "A Jira Forge print-iteration tracker",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "tsc --project tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "forge": "forge"
  },
  "dependencies": {
    "@forge/api": "8.4.0",
    "@forge/bridge": "7.2.1",
    "@forge/react": "12.4.0",
    "@forge/resolver": "2.0.2",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@forge/cli": "15.0.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "packageManager": "npm@10.9.9"
}
