{
  "name": "layerlog",
  "version": "0.1.0",
  "private": true,
  "description": "A Jira Forge print-iteration tracker",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "tsc --project tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:toolchain && npm run build",
    "forge": "node scripts/forge.mjs",
    "audit:production": "npm audit --omit=dev",
    "audit:all": "npm audit && npm audit --prefix tools/forge",
    "setup:forge": "node scripts/setup-forge.mjs",
    "test:toolchain": "node --test tests/toolchain.test.mjs"
  },
  "dependencies": {
    "@forge/api": "8.4.0",
    "@forge/bridge": "7.2.1",
    "@forge/react": "12.4.0",
    "@forge/resolver": "2.0.2",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "packageManager": "npm@10.9.9",
  "overrides": {
    "prosemirror-view": "1.42.9",
    "glob@>=9": "14.0.4",
    "minimatch@>=7": "11.0.5"
  }
}
